rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function active() {
      return signedIn() && profile().data.active == true;
    }

    function role() {
      return profile().data.role;
    }

    function manager() {
      return active() && (role() == "property_manager" || role() == "owner");
    }

    function owner() {
      return active() && role() == "owner";
    }

    function propertyAdmin(propertyId) {
      return active()
        && role() == "property_admin"
        && propertyId in profile().data.assignedProperties;
    }

    function propertyAssigned(propertyId) {
      return active() && propertyId in profile().data.assignedProperties;
    }

    function canManageProperty(propertyId) {
      return manager() || propertyAdmin(propertyId);
    }

    function propertyVisible(propertyId) {
      return manager() || propertyAssigned(propertyId);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow get: if manager();
      allow list: if manager();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.active == false
        && request.resource.data.role in ["technician", "property_manager"]
        && request.resource.data.requestedRole == request.resource.data.role
        && (
          (
            request.resource.data.role == "technician"
            && request.resource.data.accountStatus == "pending_admin"
            && request.resource.data.approvalRequiredBy == "admin"
            && request.resource.data.assignedProperties is list
            && request.resource.data.assignedProperties.size() > 0
            && request.resource.data.assignedProperties.size() <= 3
          )
          || (
            request.resource.data.role == "property_manager"
            && request.resource.data.accountStatus == "pending_owner"
            && request.resource.data.approvalRequiredBy == "owner"
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "email",
          "phone",
          "jobTitle",
          "department",
          "bio",
          "photoUrl",
          "dailyPropertyId",
          "pendingPropertyIds",
          "propertyChangeStatus",
          "propertyChangeRequestedAt",
          "propertyChangeRequestedBy",
          "updatedAt",
          "lastSeen"
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["dailyPropertyId"])
          || request.resource.data.dailyPropertyId in resource.data.assignedProperties
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "pendingPropertyIds",
            "propertyChangeStatus",
            "propertyChangeRequestedAt",
            "propertyChangeRequestedBy"
          ])
          || (
            request.resource.data.pendingPropertyIds is list
            && request.resource.data.pendingPropertyIds.size() > 0
            && request.resource.data.pendingPropertyIds.size() <= 3
            && request.resource.data.propertyChangeStatus == "pending"
            && request.resource.data.propertyChangeRequestedBy == request.auth.uid
          )
        );
      allow update: if owner();
      allow update: if manager()
        && resource.data.role in ["technician", "property_admin"]
        && request.resource.data.role in ["technician", "property_admin"];
      allow delete: if false;
    }

    match /properties/{propertyId} {
      allow get, list: if propertyVisible(resource.data.id);
      allow create, update: if manager();
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if propertyVisible(resource.data.propertyId);
      allow create: if manager() || propertyAssigned(request.resource.data.propertyId);
      allow update: if manager() || propertyAssigned(resource.data.propertyId);
      allow delete: if false;
    }

    match /outOfOrderIssues/{issueId} {
      allow read: if propertyVisible(resource.data.propertyId);
      allow create: if manager() || propertyAssigned(request.resource.data.propertyId);
      allow update: if manager() || propertyAssigned(resource.data.propertyId);
      allow delete: if false;
    }

    match /repairLogs/{logId} {
      allow read: if manager()
        || propertyAssigned(resource.data.propertyId)
        || (active() && resource.data.technicianId == request.auth.uid);

      allow create: if active()
        && request.resource.data.technicianId == request.auth.uid
        && propertyAssigned(request.resource.data.propertyId)
        && request.resource.data.approvalStatus == "pending";

      allow update: if manager()
        || propertyAssigned(resource.data.propertyId)
        || (
          active()
          && resource.data.technicianId == request.auth.uid
          && resource.data.approvalStatus in ["pending", "rejected", "needs_info"]
          && request.resource.data.technicianId == resource.data.technicianId
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.approvalStatus == "pending"
        );

      allow delete: if false;
    }

    match /scheduledMaintenance/{taskId} {
      allow read: if propertyVisible(resource.data.propertyId);
      allow create: if manager() || propertyAssigned(request.resource.data.propertyId);
      allow update: if manager()
        || propertyAssigned(resource.data.propertyId)
        || (
          active()
          && propertyAssigned(resource.data.propertyId)
          && resource.data.assignedTo == request.auth.uid
        );
      allow delete: if false;
    }

    match /pmChecklistTemplates/{templateId} {
      allow read: if propertyVisible(resource.data.propertyId);
      allow create: if canManageProperty(request.resource.data.propertyId)
        && request.resource.data.active == true
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update: if canManageProperty(resource.data.propertyId);
      allow delete: if false;
    }

    match /pmChecklistRuns/{runId} {
      allow read: if propertyVisible(resource.data.propertyId);
      allow create: if active()
        && propertyAssigned(request.resource.data.propertyId)
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.status == "in_progress";
      allow update: if canManageProperty(resource.data.propertyId)
        || (
          active()
          && propertyAssigned(resource.data.propertyId)
          && resource.data.startedBy == request.auth.uid
          && resource.data.status in ["in_progress", "rejected"]
          && request.resource.data.propertyId == resource.data.propertyId
          && request.resource.data.startedBy == resource.data.startedBy
          && request.resource.data.status in ["in_progress", "pending_approval"]
        );
      allow delete: if false;
    }
  }
}
