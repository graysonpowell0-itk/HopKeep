rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function active() {
      return signedIn()
        && (!("active" in profile().data) || profile().data.active == true)
        && (
          !("accountStatus" in profile().data)
          || profile().data.accountStatus == "approved"
        );
    }

    function projectAdmin() {
      return signedIn()
        && (
          request.auth.uid in ["23D2CaiLHXWfaPMZ4No7LV1mv342"]
          || request.auth.token.email in ["graysonpowell0@gmail.com"]
        );
    }

    function manager() {
      return projectAdmin() || (active() && profile().data.role in [
        "property_manager",
        "Property Manager",
        "property manager",
        "owner",
        "Owner",
        "admin",
        "Admin",
        "manager",
        "Manager"
      ]);
    }

    function propertyAssigned(propertyId) {
      return active() && propertyId in profile().data.assignedProperties;
    }

    function propertyVisible(propertyId) {
      return manager() || propertyAssigned(propertyId);
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function validPdf() {
      return request.resource != null
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == "application/pdf";
    }

    match /repairLogs/{propertyId}/{userId}/{allPaths=**} {
      allow read: if propertyVisible(propertyId) || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn()
        && request.auth.uid == userId
        && validImage();
    }

    match /repairLogs/{propertyId}/{allPaths=**} {
      allow read: if propertyVisible(propertyId);
      allow write: if manager() && validImage();
    }

    match /profilePhotos/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && validImage();
    }

    match /scheduledMaintenance/{propertyId}/{allPaths=**} {
      allow read: if propertyVisible(propertyId);
      allow write: if propertyVisible(propertyId) && validImage();
    }

    match /pmChecklists/{propertyId}/templates/{allPaths=**} {
      allow read: if propertyVisible(propertyId);
      allow write: if manager() && validPdf();
    }

    match /{allPaths=**} {
      allow read, delete: if projectAdmin();
      allow write: if projectAdmin()
        && request.resource != null
        && request.resource.size < 25 * 1024 * 1024;
    }
  }
}
